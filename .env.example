# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Syntony needs TWO independent Band accounts to prove the cross-org hypothesis.

# ---------- Band transport (L0) ----------
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# --- Account A: CLINIC (provider side) ---
CLINIC_USER_API_KEY=          # Human/account API key (Settings → API keys at app.band.ai)
CLINIC_HANDLE=                # this account's public handle (e.g. @clinic-foo), for contact requests
# Side PRIMARY agent (also role provider.intake; room creator + fallback for non-promoted roles):
CLINIC_AGENT_ID=
CLINIC_AGENT_API_KEY=

# --- Account B: PAYER (insurer side) ---
PAYER_USER_API_KEY=           # Human/account API key for the SECOND account
PAYER_HANDLE=
# Side PRIMARY agent (also role payer.reviewer):
PAYER_AGENT_ID=
PAYER_AGENT_API_KEY=

# ---------- Balanced mesh: extra per-role agents (auto-filled by `python provision_agents.py`) ----------
# These make the cross-org mesh VISIBLE on Band (more than 2 participants). The provision script
# registers them from the Human keys above — no dashboard clicks. Missing → that role falls back to
# its side primary, so the app runs fine with these blank.
PROVIDER_COUNSEL_AGENT_ID=
PROVIDER_COUNSEL_AGENT_API_KEY=
PROVIDER_ELIGIBILITY_AGENT_ID=
PROVIDER_ELIGIBILITY_AGENT_API_KEY=
PAYER_PHARMACY_AGENT_ID=
PAYER_PHARMACY_AGENT_API_KEY=
PAYER_GUIDELINES_AGENT_ID=
PAYER_GUIDELINES_AGENT_API_KEY=

# ---------- LLM providers (app-level; Band never sees these) ----------
AIML_API_KEY=                 # AI/ML API gateway — every agent's model (400+ models, one key)
ANTHROPIC_API_KEY=            # optional, if calling Anthropic directly
